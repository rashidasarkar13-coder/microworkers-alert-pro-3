<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>MicroWorkers Alert Pro</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f2f4f7;
        }

        .app {
            max-width: 500px;
            margin: auto;
            min-height: 100vh;
            background: white;
        }

        header {
            padding: 20px;
            background: #111827;
            color: white;
        }

        header h1 {
            margin: 0;
            font-size: 22px;
        }

        .content {
            padding: 20px;
        }

        .status {
            padding: 15px;
            border-radius: 12px;
            background: #dcfce7;
            color: #166534;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .card {
            padding: 18px;
            margin-bottom: 15px;
            border-radius: 15px;
            background: #f8fafc;
        }

        .keyword {
            padding: 10px 0;
        }

        input[type="text"] {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        button {
            width: 100%;
            padding: 15px;
            border: 0;
            border-radius: 10px;
            background: #16a34a;
            color: white;
            font-size: 16px;
            font-weight: bold;
        }

        .stop {
            background: #dc2626;
            margin-top: 10px;
        }
    </style>
</head>

<body>

<div class="app">

    <header>
        <h1>🤖 MicroWorkers Alert Pro</h1>
    </header>

    <div class="content">

        <div class="status" id="status">
            🟢 Monitoring ON
        </div>

        <div class="card">

            <h3>Keywords</h3>

            <div class="keyword">
                ☑ update email
            </div>

            <div class="keyword">
                ☑ mail
            </div>

            <div class="keyword">
                ☑ name email
            </div>

            <div class="keyword">
                ☑ website email
            </div>

        </div>

        <div class="card">

            <h3>Minimum Reward</h3>

            <input
                type="text"
                value="$0.05"
                id="reward">

        </div>

        <div class="card">

            <h3>Notifications</h3>

            <div class="keyword">
                🔊 Sound: ON
            </div>

            <div class="keyword">
                📳 Vibration: ON
            </div>

        </div>

        <button onclick="startBot()">
            START BOT
        </button>

        <button class="stop" onclick="stopBot()">
            STOP BOT
        </button>

    </div>

</div>

<script>

function startBot() {
    document.getElementById("status").innerHTML =
        "🟢 Monitoring ON";
}

function stopBot() {
    document.getElementById("status").innerHTML =
        "🔴 Monitoring OFF";
}

</script>

</body>
</html>
